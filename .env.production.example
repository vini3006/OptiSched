# Production env for docker-compose.prod.yml, lives alongside it on the EC2
# host (see docs/deploy-readiness-plan.md, Parte B). Copy to .env there and
# fill in real values — never commit the filled-in file.
#
# Dev-only vars (DB_NAME/DB_USER/DB_PASSWORD's local meaning, etc.) are in
# .env.example at the repo root; this file only covers what's different or
# additional for production.

# Domain the API is served from — Caddy requests/renews its TLS certificate
# for exactly this domain, and reverse-proxies it to the api service.
# DNS must already point here before the stack comes up, or cert issuance fails.
API_DOMAIN=api.yourdomain.com

# Supabase connection details (Database settings -> Connection string).
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Real domain of the Vercel-hosted frontend, no trailing slash. Used both to
# build links in e-mails (FRONTEND_URL) and as the API's CORS allowlist
# (CORS_ALLOWED_ORIGINS) — normally the same value.
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Bootstrap super-admin account, applied via Flyway on first boot.
# SUPER_ADMIN_PASSWORD_HASH is a bcrypt hash, not a raw password.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD_HASH=

# Shared secret between api and optimizer (X-Internal-Key header) — generate
# with `openssl rand -base64 32`. Must be the same value the optimizer
# service also receives.
OPTIMIZER_INTERNAL_KEY=

# Real e-mail delivery in production.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=OptiSched <onboarding@resend.dev>

# Redis password (JWT logout blacklist + distributed rate limiting).
# Generate with, e.g., `openssl rand -base64 32`.
REDIS_PASSWORD=
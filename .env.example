DB_NAME=optisched
DB_USER=your_user
DB_PASSWORD=your_password

# Postgres SSL mode appended to the JDBC URL (?sslmode=...). Leave as
# "disable" for local dev; production (Supabase) must use "require".
DB_SSL_MODE=disable

# Base URL of the frontend, used to build links sent in e-mails (e.g. the
# password-reset link). Defaults to http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# Origin the API's CORS policy allows (must match the frontend's real URL,
# no trailing slash). Defaults to http://localhost:5173 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to true only over HTTPS — marks the access_token cookie Secure, so
# browsers refuse to send it over plain HTTP. Defaults to false (dev).
COOKIE_SECURE=false

# Bootstrap super-admin account, applied via a Flyway migration placeholder
# on first boot. SUPER_ADMIN_PASSWORD_HASH is a bcrypt hash, not a raw
# password — generate one with, e.g., htpasswd or Spring's BCryptPasswordEncoder.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD_HASH=

# Shared secret the API sends as the X-Internal-Key header on every call to
# the Optimizer, and the Optimizer checks on /api/optimize — closes off
# direct public access to a service that has no auth of its own. Must match
# on both sides. Generate with, e.g., `openssl rand -base64 32`.
OPTIMIZER_INTERNAL_KEY=

# Which EmailSender bean is active: "log" (default, just logs the link —
# no real e-mail sent) or "resend" (sends via the Resend API, requires the
# two vars below).
EMAIL_PROVIDER=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=OptiSched <onboarding@resend.dev>

# Set to false in production to silence SQL statement logging and disable
# the Swagger/OpenAPI UI. Both default to true (dev-friendly).
JPA_SHOW_SQL=true
SWAGGER_ENABLED=true